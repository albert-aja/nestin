# Server Configuration
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info
APP_VERSION=1.0.0
MIN_SUPPORTED_MOBILE_VERSION=1.0.0

# Rate Limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Supabase Infrastructure (fill in from `supabase status` or hosted project settings)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only secret! NEVER copy SUPABASE_SERVICE_ROLE_KEY into apps/mobile
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
