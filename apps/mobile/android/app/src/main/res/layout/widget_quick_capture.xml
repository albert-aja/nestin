<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_capture_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <!-- Leading Scout Quick-Assist Companion Pill -->
    <LinearLayout
        android:id="@+id/btn_qc_scout"
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_tile_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_mascot_halo_scout"
            android:padding="3dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_mascot_scout_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/mascot_widget_scout_captured" />
        </FrameLayout>
    </LinearLayout>

    <!-- Tile 1: Quick Note (Twill) -->
    <LinearLayout
        android:id="@+id/btn_qc_note"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_tile_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:id="@+id/layout_qc_note_mascot"
            android:layout_width="28dp"
            android:layout_height="28dp">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_mascot_halo_twill"
                android:padding="3dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_mascot_twill_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mascot_widget_twill_noted" />
            </FrameLayout>

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="bottom|end"
                android:contentDescription="Note"
                android:src="@drawable/ic_widget_note" />
        </FrameLayout>

        <ImageView
            android:id="@+id/iv_qc_note_classic"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Note"
            android:src="@drawable/ic_widget_note"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:text="Note"
            android:textColor="#D1D5DB"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tile 2: Quick Task (Roo) -->
    <LinearLayout
        android:id="@+id/btn_qc_task"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_tile_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:id="@+id/layout_qc_task_mascot"
            android:layout_width="28dp"
            android:layout_height="28dp">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_mascot_halo_roo"
                android:padding="3dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_mascot_roo_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mascot_widget_roo_planning" />
            </FrameLayout>

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="bottom|end"
                android:contentDescription="Task"
                android:src="@drawable/ic_widget_task" />
        </FrameLayout>

        <ImageView
            android:id="@+id/iv_qc_task_classic"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Task"
            android:src="@drawable/ic_widget_task"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:text="Task"
            android:textColor="#D1D5DB"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tile 3: New Alarm (Roo) -->
    <LinearLayout
        android:id="@+id/btn_qc_alarm"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_tile_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:id="@+id/layout_qc_alarm_mascot"
            android:layout_width="28dp"
            android:layout_height="28dp">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_mascot_halo_roo"
                android:padding="3dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_mascot_roo_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mascot_widget_roo_alarm" />
            </FrameLayout>

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="bottom|end"
                android:contentDescription="Alarm"
                android:src="@drawable/ic_widget_alarm" />
        </FrameLayout>

        <ImageView
            android:id="@+id/iv_qc_alarm_classic"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Alarm"
            android:src="@drawable/ic_widget_alarm"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:text="Alarm"
            android:textColor="#D1D5DB"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tile 4: Journal Entry (Echo) -->
    <LinearLayout
        android:id="@+id/btn_qc_journal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_tile_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:id="@+id/layout_qc_journal_mascot"
            android:layout_width="28dp"
            android:layout_height="28dp">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_mascot_halo_echo"
                android:padding="3dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_mascot_echo_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mascot_widget_echo_reflect" />
            </FrameLayout>

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="bottom|end"
                android:contentDescription="Journal"
                android:src="@drawable/ic_widget_journal" />
        </FrameLayout>

        <ImageView
            android:id="@+id/iv_qc_journal_classic"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Journal"
            android:src="@drawable/ic_widget_journal"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:text="Journal"
            android:textColor="#D1D5DB"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
