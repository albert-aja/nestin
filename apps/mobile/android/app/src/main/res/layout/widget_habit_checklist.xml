<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header: Title, Streak and Progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_habit_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Morning Energizer"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_habit_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_pill_bg"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="🔥 3d"
            android:textColor="#FF9E1B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_habit_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2/4"
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#222530" />

    <!-- Step 1 -->
    <LinearLayout
        android:id="@+id/layout_step_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_step_1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Step status"
            android:src="@drawable/ic_widget_check" />

        <TextView
            android:id="@+id/tv_step_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Drink 500ml water"
            android:textColor="#E5E7EB"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Step 2 -->
    <LinearLayout
        android:id="@+id/layout_step_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_step_2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Step status"
            android:src="@drawable/ic_widget_check" />

        <TextView
            android:id="@+id/tv_step_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="5-minute light stretching"
            android:textColor="#E5E7EB"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Step 3 -->
    <LinearLayout
        android:id="@+id/layout_step_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_step_3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Step status"
            android:src="@drawable/ic_widget_uncheck" />

        <TextView
            android:id="@+id/tv_step_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Plan top 3 daily priorities"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Step 4 -->
    <LinearLayout
        android:id="@+id/layout_step_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_step_4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Step status"
            android:src="@drawable/ic_widget_uncheck" />

        <TextView
            android:id="@+id/tv_step_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Healthy balanced breakfast"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>

